{
  "name": "helia-esbuild",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bundle Helia with esbuild",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "mkdir -p dist && cp src/index.html src/style.css dist && node esbuild.js",
    "start": "npm run build && esbuild --servedir=dist",
    "test": "npm run build && test-browser-example test"
  },
  "browserslist": "last 1 Chrome version",
  "dependencies": {
    "@helia/unixfs": "^8.0.9",
    "helia": "^7.1.16"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@playwright/test": "^1.65.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "process": "^0.11.10",
    "rimraf": "^6.1.4",
    "test-ipfs-example": "^1.3.3"
  }
}
